# Copy to apps/web/.env.local and fill in real values locally. Never commit it.
# Everything here is NEXT_PUBLIC_* — inlined into the browser bundle, so only
# public values belong in this file. Server secrets live in apps/api/.env.

NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
# Canonical site origin, no trailing slash. Used for SEO (canonical URLs,
# sitemap.xml, Open Graph). Placeholder until a production domain exists.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
