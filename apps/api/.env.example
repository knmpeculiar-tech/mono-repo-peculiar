# Copy to apps/api/.env and fill in real values locally. Never commit .env.
# Read by the API (src/config/env.ts) and by the Prisma CLI.

# --- Database (Prisma + Supabase Postgres) ---
# Pooled connection (Supabase "Transaction" pooler, port 6543) — used by the app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Supabase (server-side only — never expose these to apps/web) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="<secret-key>"
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# --- Razorpay ---
# Both key sets can be filled in at once; RAZORPAY_MODE picks the active one,
# so switching test <-> live is a one-word change (then restart the API).
# Keys: Razorpay Dashboard -> Account & Settings -> API Keys (toggle Test/Live).
# The API sends the active Key ID to the browser with each order, so apps/web
# needs no Razorpay settings of its own.
RAZORPAY_MODE="test"

RAZORPAY_TEST_KEY_ID="rzp_test_..."
RAZORPAY_TEST_KEY_SECRET="<test-key-secret>"
# From the webhook you create in Test mode (Dashboard -> Webhooks). Optional
# until a webhook exists; webhooks are rejected while it's blank.
RAZORPAY_TEST_WEBHOOK_SECRET=""

RAZORPAY_LIVE_KEY_ID="rzp_live_..."
RAZORPAY_LIVE_KEY_SECRET="<live-key-secret>"
RAZORPAY_LIVE_WEBHOOK_SECRET=""

# Local dev only: "true" skips Razorpay entirely (fake orders, a "simulate
# payment" button instead of the real widget) so checkout works with no keys.
# The API refuses to start with it on in production or in live mode.
PAYMENTS_MOCK="false"

# --- Keep-alive ---
# Hours between tiny Supabase pings so the free-plan project isn't paused after
# 7 days without activity (only works on an always-on server like the VPS).
# 0 turns it off once real traffic keeps the project busy.
KEEP_ALIVE_HOURS=24
