# Build context is the repo root (pnpm workspace + lockfile live here). Keep
# secrets, dependencies and build output out of the image.
.git
**/node_modules
**/dist
**/.next
**/prisma/generated
**/.env
**/.env.*
!**/.env.example
**/*.log
**/.DS_Store
docs
.claude
deploy
# The API image doesn't need the frontend — except its package.json, which the
# pnpm workspace expects to find for the lockfile to match.
apps/web/*
!apps/web/package.json
